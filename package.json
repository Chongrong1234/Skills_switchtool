{
  "name": "skills-switchtool",
  "version": "1.2.0",
  "description": "项目中心化的 Agent Skills 管理工具(Web GUI / Electron 桌面 App / CLI)",
  "keywords": [
    "agent-skills",
    "claude-code",
    "kimi-code",
    "cursor",
    "codex",
    "skills-manager"
  ],
  "license": "MIT",
  "author": "Chongrong1234",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chongrong1234/Skills_switchtool.git"
  },
  "bugs": "https://github.com/Chongrong1234/Skills_switchtool/issues",
  "homepage": "https://github.com/Chongrong1234/Skills_switchtool#readme",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "ssw": "dist/cli.js",
    "skills": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"fs.chmodSync('dist/cli.js',0o755)\"",
    "test": "vitest run",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:cli": "npm run build && node scripts/build-cli.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
